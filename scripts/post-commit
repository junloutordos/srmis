#!/bin/bash
# Auto-bump patch version on every commit to main.
# Skips if the commit is already a version bump (prevents infinite loop).

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
[ "$BRANCH" = "main" ] || exit 0

LAST_MSG=$(git log -1 --pretty=%s)
[[ "$LAST_MSG" == "chore: bump version"* ]] && exit 0

REMARKS=$(git log -1 --pretty=%B | head -1)

cd "$(git rev-parse --show-toplevel)" || exit 0

./bump-version.sh auto "$REMARKS" > /dev/null 2>&1

git add version.json
git commit -m "chore: bump version — $REMARKS" --no-verify > /dev/null 2>&1

echo "[post-commit] Version bumped automatically."
